    {
      "parameters": {
        "jsCode": "// Memoria de deduplicacao\nconst staticData = $getWorkflowStaticData('global');\nstaticData.seenJobIds = staticData.seenJobIds || [];\n\nconst resultado = [];\n\nfor (const item of $input.all()) {\n  const job = item.json;\n  const id = job.job_id;\n\n  if (!id || staticData.seenJobIds.includes(id)) {\n    continue;\n  }\n\n  const title = (job.job_title || '').toLowerCase();\n  const desc = (job.job_description || '').toLowerCase();\n  const city = (job.job_city || '').toLowerCase();\n  const location = (job.job_location || '').toLowerCase();\n\n  const isFeira = /feira\\s*de\\s*santana|fsa/.test(city) ||\n                  /feira\\s*de\\s*santana|fsa/.test(location) ||\n                  /feira\\s*de\\s*santana/.test(desc);\n\n  const isRemote = job.job_is_remote === true || \n                   /remoto|home\\s*office/i.test(title) ||\n                   /100%\\s*remoto|trabalho\\s*remoto/i.test(desc);\n\n  const isAdmin = /administrativ|auxiliar|secretari|escritorio/i.test(title);\n\n  // 1. Auxiliar Administrativo CLT em Feira de Santana\n  if (isAdmin) {\n    if (!isFeira) continue;\n    if (isRemote) continue;\n    const isME = /\\b(mei|pj|pessoa\\s*jurídica|pessoa\\s*juridica|microempresa|micro\\s*empreendedor|comissionado|autônomo|autonomo)\\b/i.test(desc) || /\\b(mei|pj)\\b/i.test(title);\n    if (isME) continue;\n\n    job.categoria = 'admin_fsa';\n    staticData.seenJobIds.push(id);\n    resultado.push(item);\n    continue;\n  }\n\n  // 2. Vaga Local de TI em Feira de Santana\n  if (isFeira) {\n    job.categoria = 'ti_fsa';\n    staticData.seenJobIds.push(id);\n    resultado.push(item);\n    continue;\n  }\n\n  // 3. Vagas Remotas de Dev ou TI\n  if (isRemote) {\n    const isDev = /desenvolvedor|developer|dev|frontend|backend|fullstack|software|web|programador|react|node|python|java|javascript/i.test(title) ||\n                  /desenvolvedor|programador/i.test(desc);\n\n    if (isDev) {\n      job.categoria = 'dev_remoto';\n    } else {\n      job.categoria = 'ti_geral';\n    }\n    staticData.seenJobIds.push(id);\n    resultado.push(item);\n  }\n}\n\nif (staticData.seenJobIds.length > 300) {\n  staticData.seenJobIds = staticData.seenJobIds.slice(-300);\n}\n\nreturn resultado;"
      },
